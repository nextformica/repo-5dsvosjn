# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF

# ---------- LLM ----------
# Провайдер по умолчанию: openai | gemini | deepseek | openrouter | ollama | lmstudio | custom
# Переключать на лету можно командой /llm <provider> [model] (только админ), выбор сохраняется в БД.
LLM_PROVIDER=openai

# Ключи провайдеров — заполни те, которыми пользуешься. Если у выбранного провайдера ключа нет,
# бот работает в демо-режиме (MockLLM) и отдаёт заглушки.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Локальные модели (ключ не нужен, просто запусти сервер):
#   ollama serve && ollama pull llama3.1      → /llm ollama llama3.1
#   LM Studio → Developer → Start Server      → /llm lmstudio
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Общий ключ-фолбэк (подставляется любому провайдеру без своего ключа) и переопределение модели.
LLM_API_KEY=
LLM_MODEL=
# Любой другой OpenAI-совместимый endpoint → появится провайдер "custom".
LLM_BASE_URL=

# Сколько бесплатных генераций в триале
FREE_GENERATIONS=3

# Telegram user_id администраторов через запятую (могут выдавать премиум командой /grant и менять LLM)
ADMIN_IDS=

# Контакт для оплаты, пока не подключён эквайринг
PAYMENT_CONTACT=@your_username

DB_PATH=data/bot.db
