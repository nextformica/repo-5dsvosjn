# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF

# ---------- LLM ----------
# Провайдер по умолчанию: openai | gemini | deepseek | openrouter | ollama | lmstudio | custom
# Переключать на лету можно командой /llm <provider> [model] (только админ), выбор сохраняется в БД.
LLM_PROVIDER=openai

# Ключи провайдеров — заполни те, которыми пользуешься. Если у выбранного провайдера ключа нет,
# бот работает в демо-режиме (MockLLM) и отдаёт заглушки.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Локальные модели (ключ не нужен, просто запусти сервер):
#   ollama serve && ollama pull llama3.1      → /llm ollama llama3.1
#   LM Studio → Developer → Start Server      → /llm lmstudio
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Общий ключ-фолбэк (подставляется любому провайдеру без своего ключа) и переопределение модели.
LLM_API_KEY=
LLM_MODEL=
# Любой другой OpenAI-совместимый endpoint → появится провайдер "custom".
LLM_BASE_URL=

# Сколько бесплатных генераций в триале
FREE_GENERATIONS=3

# Telegram user_id администраторов через запятую (могут выдавать премиум командой /grant и менять LLM)
ADMIN_IDS=

DB_PATH=data/bot.db

# ---------- Оплата ----------
# Активный способ: manual | yookassa | robokassa | platega. Переключать на лету: /pay <provider> (админ).
# Если у выбранного способа не заполнены ключи — бот откатывается на manual.
PAYMENT_PROVIDER=manual
# manual: мастер пишет сюда, админ включает доступ /grant <user_id>
PAYMENT_CONTACT=@your_username
# На сколько дней включать подписку после оплаты
SUBSCRIPTION_DAYS=30

# ЮKassa (https://yookassa.ru/my → Интеграция → Ключи API). СБП включается в ЛК ЮKassa;
# YOOKASSA_SBP_ONLY=true — сразу открывать QR СБП, иначе мастер выбирает способ на странице ЮKassa.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_SBP_ONLY=false

# Robokassa (https://partner.robokassa.ru → Технические настройки). Алгоритм хэша — как в ЛК (md5 | sha256 | ...).
# ROBOKASSA_INC_CURR_LABEL=SBPPSR — сразу открывать оплату через СБП (label из XML-списка валют).
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST=false
ROBOKASSA_HASH=md5
ROBOKASSA_INC_CURR_LABEL=

# Platega (https://docs.platega.io). PLATEGA_PAYMENT_METHOD: 2 — СБП QR, 11 — карты, 14 — SberPay.
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_PAYMENT_METHOD=2

# Вебхуки платёжек: POST http://<ваш-домен>/webhook/{yookassa|robokassa|platega}.
# 0 — сервер выключен; тогда оплата подтверждается кнопкой «Я оплатила» (бот сам спрашивает статус у платёжки).
WEBHOOK_PORT=0
WEBHOOK_HOST=0.0.0.0
