# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF

# Ключ LLM. Если пусто — бот работает в режиме заглушки (MockLLM) и отдаёт демо-тексты.
LLM_API_KEY=
# OpenAI-совместимый endpoint. Примеры:
#   https://api.openai.com/v1            (OpenAI)
#   https://openrouter.ai/api/v1         (OpenRouter — работает из РФ)
#   https://api.deepseek.com/v1          (DeepSeek)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Сколько бесплатных генераций в триале
FREE_GENERATIONS=3

# Telegram user_id администраторов через запятую (могут выдавать премиум командой /grant)
ADMIN_IDS=

# Контакт для оплаты, пока не подключён эквайринг
PAYMENT_CONTACT=@your_username

DB_PATH=data/bot.db
